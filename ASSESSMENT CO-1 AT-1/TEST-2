
from decimal import Decimal
import sys

print(type(10))
print(type(10.0))
print(type("10"))
print(type(True))
print(type([10, 8, 5]))

print(7 / 2)
print(7 // 2)
print(7 % 2)
print(-7 // 2)

print(0.1 + 0.2)
print(0.1 + 0.2 == 0.3)

payments = [33.40] * 1000 + [0.10] * 3

def total_float(items):
    total = 0.0
    for amount in items:
        total += float(amount)
    return total

def total_decimal(items):
    total = Decimal("0.00")
    for amount in items:
        total += Decimal(str(amount))
    return total

print("Float:", total_float(payments))
print("Decimal:", total_decimal(payments))
print("Decimal from float:", Decimal(float(0.1)))

print("Float memory:", sys.getsizeof(0.1))
print("Decimal memory:", sys.getsizeof(Decimal("0.1")))
