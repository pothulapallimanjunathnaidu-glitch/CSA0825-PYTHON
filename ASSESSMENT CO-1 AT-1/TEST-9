
BASE_RATE = 30.00
FAT_STEP_VALUE = 0.40
SNF_STEP_VALUE = 0.30

def rate_per_litre(fat, snf):
    fat_steps = round((fat - 3.5) / 0.1)
    snf_steps = round((snf - 8.5) / 0.1)

    return round(
        BASE_RATE
        + fat_steps * FAT_STEP_VALUE
        + snf_steps * SNF_STEP_VALUE,
        2
    )

def payout(litres, fat, snf):
    return round(litres * rate_per_litre(fat, snf), 2)

def calculate_payment(litres, fat, snf):
    if litres < 0:
        return "Invalid: litres cannot be negative"

    if fat < 2.0 or fat > 7.0:
        return "Invalid: fat must be between 2 and 7"

    if snf < 0:
        return "Invalid: SNF cannot be negative"

    rate = rate_per_litre(fat, snf)
    amount = payout(litres, fat, snf)

    return rate, amount

print("Milk Payment Calculator")

litres = float(input("Enter litres: "))
fat = float(input("Enter fat percentage: "))
snf = float(input("Enter SNF percentage: "))

result = calculate_payment(litres, fat, snf)

if isinstance(result, tuple):
    print(f"Rate per litre: Rs. {result[0]:.2f}")
    print(f"Payment amount: Rs. {result[1]:.2f}")
else:
    print(result)

print("\nTesting 5 entries")

test_entries = [
    (10, 3.5, 8.5),
    (8.5, 4.2, 8.7),
    (12, 3.1, 8.3),
    (-2, 3.5, 8.5),
    (10, 8.0, 8.5)
]

for entry in test_entries:
    print(entry, "->", calculate_payment(*entry))
